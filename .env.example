# Gemini API Configuration (get a key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini overrides
# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_EMBED_MODEL=gemini-embedding-2
# GEMINI_EMBED_DIM=768
# GEMINI_MODELS=gemini-4-hydrogen,gemini-3.5-flash-lite
# GEMINI_TIMEOUT=120

# JWT signing secret (change this to a secure random string in production)
JWT_SECRET=supersecretkeyforlocaldevelopmentonly

# Port to bind the server on
PORT=8000

# Worker processes. Keep at 1 unless you externalise the in-process caches,
# vector index and WebSocket registry (each worker gets its own copy).
WORKERS=1

# development | production
ENV=development

# Comma-separated browser origins allowed by CORS.
# A "*" entry disables credentialed CORS.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Database URL for your backend. Use a hosted Supabase/Postgres URL in production.
# Example: DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./orchestrator.db

# Optional Supabase project info for client integration or admin tooling.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: directory containing the built frontend.
# Defaults to frontend/dist when present, otherwise frontend/.
# FRONTEND_DIR=/app/frontend/dist

# Frontend dev server only: backend URL used by the Vite proxy.
# VITE_BACKEND_URL=http://localhost:8000
